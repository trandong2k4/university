# ============================================
# Frontend Configuration - Development
# ============================================

# API Configuration
VITE_API_BASE_URL=http://localhost:8080/api
VITE_API_TIMEOUT=30000

# Feature Flags
# VITE_USE_MOCK_DATA=false   → Use local mock data (development)
# VITE_USE_MOCK_DATA=false  → Use real Spring Boot backend (ready for integration)
VITE_USE_MOCK_DATA=false
VITE_ENABLE_DEBUG_LOGS=true

# Mock Delay (milliseconds) - simulate network latency
# Helps test loading states
VITE_MOCK_DATA_DELAY=300

# Environment
# development | staging | production
VITE_ENVIRONMENT=development
