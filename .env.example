# Environment Configuration
# Copy this file to .env and update values based on your environment

# API Configuration
VITE_API_BASE_URL=http://localhost:8080/api
VITE_API_TIMEOUT=10000

# Mock Data Configuration (true for development, false for production)
VITE_USE_MOCK_DATA=true

# Feature Flags
VITE_ENABLE_DEBUG_LOGS=true
